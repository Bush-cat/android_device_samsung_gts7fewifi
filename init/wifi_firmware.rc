on early-init

# bootloader revision 2
on fs && property:ro.boot.rp=2
    mount none /vendor/firmware/wlan/rev2/wpss.b01 /vendor/firmware/wpss.b01 bind
    mount none /vendor/firmware/wlan/rev2/wpss.mdt /vendor/firmware/wpss.mdt bind

